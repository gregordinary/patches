From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gregordinary <33880035+gregordinary@users.noreply.github.com>
Date: Sun, 9 Aug 2026 13:20:00 -0400
Subject: [PATCH] lavu/hwcontext_rkmpp: honour device-level cacheable buffer
 flags

MPP allocation flags exist at two levels: AVRKMPPFramesContext.flags and
AVRKMPPDeviceContext.flags, the frames context inheriting the device's.
rkmpp_map_frame() and rkmpp_unmap_frame() tested only the frames-level
value, so a caller that asked for cacheable buffers on the device context
got a CPU mapping with no DMA_BUF_IOCTL_SYNC around it -- stale reads, or
writes the device never sees.

Combine both levels, and decide once: the effective answer is stored in the
mapping so unmap ends the access the same way map began it. Reading the
frames context again at unmap would let a flags change between the two
produce a DMA_BUF_SYNC_END with no matching START, or drop the END for an
access that started with one.

Signed-off-by: gregordinary <33880035+gregordinary@users.noreply.github.com>
---
 libavutil/hwcontext_rkmpp.c | 27 +++++++++++++++++++++++----
 1 file changed, 23 insertions(+), 4 deletions(-)

diff --git a/libavutil/hwcontext_rkmpp.c b/libavutil/hwcontext_rkmpp.c
index f82e00e..ea5c331 100644
--- a/libavutil/hwcontext_rkmpp.c
+++ b/libavutil/hwcontext_rkmpp.c
@@ -352,22 +352,40 @@ typedef struct RKMPPDRMMapping {
     // Address and length of each mmap()ed region.
     int nb_regions;
     int sync_flags;
+    // Whether these regions need DMA_BUF_IOCTL_SYNC, decided once at map time so
+    // that unmap cannot reach the opposite conclusion.
+    int cacheable;
     int object[AV_DRM_MAX_PLANES];
     void *address[AV_DRM_MAX_PLANES];
     size_t length[AV_DRM_MAX_PLANES];
     int unmap[AV_DRM_MAX_PLANES];
 } RKMPPDRMMapping;
 
+/**
+ * Whether a buffer of this frames context is CPU-cacheable, and so needs
+ * explicit dma-buf synchronisation around a CPU map.
+ *
+ * The allocation flags exist at two levels: a frames context carries its own,
+ * and inherits the device context's. Either one asking for cacheable memory
+ * makes the buffer cacheable, so both are consulted.
+ */
+static int rkmpp_frames_are_cacheable(AVHWFramesContext *hwfc)
+{
+    const AVRKMPPFramesContext *avfc = hwfc->hwctx;
+    const AVRKMPPDeviceContext *hwctx = hwfc->device_ctx->hwctx;
+
+    return ((avfc->flags | hwctx->flags) & MPP_BUFFER_FLAGS_CACHABLE) != 0;
+}
+
 static void rkmpp_unmap_frame(AVHWFramesContext *hwfc,
                               HWMapDescriptor *hwmap)
 {
-    AVRKMPPFramesContext *avfc = hwfc->hwctx;
     RKMPPDRMMapping *map = hwmap->priv;
 
     for (int i = 0; i < map->nb_regions; i++) {
 #if HAVE_LINUX_DMA_BUF_H
         struct dma_buf_sync sync = { .flags = DMA_BUF_SYNC_END | map->sync_flags };
-        if (avfc->flags & MPP_BUFFER_FLAGS_CACHABLE)
+        if (map->cacheable)
             ioctl(map->object[i], DMA_BUF_IOCTL_SYNC, &sync);
 #endif
         if (map->address[i] && map->unmap[i])
@@ -380,7 +398,6 @@ static void rkmpp_unmap_frame(AVHWFramesContext *hwfc,
 static int rkmpp_map_frame(AVHWFramesContext *hwfc,
                            AVFrame *dst, const AVFrame *src, int flags)
 {
-    AVRKMPPFramesContext *avfc = hwfc->hwctx;
     const AVRKMPPDRMFrameDescriptor *desc = (AVRKMPPDRMFrameDescriptor *)src->data[0];
 #if HAVE_LINUX_DMA_BUF_H
     struct dma_buf_sync sync_start = { 0 };
@@ -394,6 +411,8 @@ static int rkmpp_map_frame(AVHWFramesContext *hwfc,
     if (!map)
         return AVERROR(ENOMEM);
 
+    map->cacheable = rkmpp_frames_are_cacheable(hwfc);
+
     mmap_prot = 0;
     if (flags & AV_HWFRAME_MAP_READ)
         mmap_prot |= PROT_READ;
@@ -441,7 +460,7 @@ static int rkmpp_map_frame(AVHWFramesContext *hwfc,
 #if HAVE_LINUX_DMA_BUF_H
         /* We're not checking for errors here because the kernel may not
          * support the ioctl, in which case its okay to carry on */
-        if (avfc->flags & MPP_BUFFER_FLAGS_CACHABLE)
+        if (map->cacheable)
             ioctl(desc->drm_desc.objects[i].fd, DMA_BUF_IOCTL_SYNC, &sync_start);
 #endif
     }
-- 
2.43.0
