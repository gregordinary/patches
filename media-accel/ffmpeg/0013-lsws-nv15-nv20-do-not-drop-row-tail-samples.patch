From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gregordinary <33880035+gregordinary@users.noreply.github.com>
Date: Sun, 9 Aug 2026 13:30:00 -0400
Subject: [PATCH] lsws: do not drop NV15/NV20 samples at the end of a row

nv15_20ToPlanarWrapper() stepped whole five-byte groups: `src_w / 4` for
luma and `chrSrcW / 2` for chroma. Both truncate. A luma row whose width is
not a multiple of four loses its last one to three samples, and a chroma
row of odd width loses its last U and V, leaving the destination's right
edge as whatever the buffer held before.

The widths this reaches are ordinary ones. 1920 and 3840 divide cleanly;
1366 does not, and loses two pixels per row.

Extract by sample index instead. Each index touches only the two bytes its
own sample spans, so a trailing partial group is read exactly as far as the
samples it carries and no further.

The chroma slice height is deliberately left as `srcSliceH / vsub`. It
truncates the same way, but changing it is slice arithmetic rather than
row arithmetic -- the destination row count and the next slice's starting
chroma row both derive from it -- and rounding it up without adjusting
those risks writing a row past the end of the plane. That is a separate
change with a separate proof.

Signed-off-by: gregordinary <33880035+gregordinary@users.noreply.github.com>
---
 libswscale/swscale_unscaled.c | 40 +++++++++++++++++++++++------------
 1 file changed, 27 insertions(+), 13 deletions(-)

diff --git a/libswscale/swscale_unscaled.c b/libswscale/swscale_unscaled.c
index b1be6d4..885eb7e 100644
--- a/libswscale/swscale_unscaled.c
+++ b/libswscale/swscale_unscaled.c
@@ -265,6 +265,27 @@ static int nv24ToYuv420Wrapper(SwsInternal *c, const uint8_t *const src[],
     return srcSliceH;
 }
 
+/**
+ * Extract packed 10-bit sample @p idx from an NV15/NV20 bitstream row: four
+ * samples to every five bytes, little-endian, no padding between them.
+ *
+ * Indexing by sample rather than stepping whole groups is what lets a row whose
+ * length is not a multiple of four be finished. Each case touches only the two
+ * bytes its own sample spans, so a trailing partial group is never read beyond
+ * the bytes that actually carry its samples.
+ */
+static av_always_inline unsigned nv15_20_get_sample(const uint8_t *src, int idx)
+{
+    const uint8_t *g = src + (idx >> 2) * 5;
+
+    switch (idx & 3) {
+    case 0:  return ((g[1] & 0x03) << 8) |  (g[0]       & 0xFF);
+    case 1:  return ((g[2] & 0x0F) << 6) | ((g[1] >> 2) & 0x3F);
+    case 2:  return ((g[3] & 0x3F) << 4) | ((g[2] >> 4) & 0x0F);
+    default: return ((g[4] & 0xFF) << 2) | ((g[3] >> 6) & 0x03);
+    }
+}
+
 static int nv15_20ToPlanarWrapper(SwsInternal *c, const uint8_t *const src8[],
                                   const int srcStride[], int srcSliceY,
                                   int srcSliceH, uint8_t *const dstParam[],
@@ -292,13 +313,8 @@ static int nv15_20ToPlanarWrapper(SwsInternal *c, const uint8_t *const src8[],
     for (y = srcSliceH; y > 0; y--) {
         const uint8_t *tsrcY = src[0];
         uint16_t *tdstY = dstY;
-        for (x = c->opts.src_w / 4; x > 0; x--) {
-            *tdstY++ = (((tsrcY[1] & 0x3 ) << 8) | (tsrcY[0]        & 0xFF)) << shift[0];
-            *tdstY++ = (((tsrcY[2] & 0xF ) << 6) | ((tsrcY[1] >> 2) & 0x3F)) << shift[0];
-            *tdstY++ = (((tsrcY[3] & 0x3F) << 4) | ((tsrcY[2] >> 4) & 0xF )) << shift[0];
-            *tdstY++ = (((tsrcY[4] & 0xFF) << 2) | ((tsrcY[3] >> 6) & 0x3 )) << shift[0];
-            tsrcY += 5;
-        }
+        for (x = 0; x < c->opts.src_w; x++)
+            *tdstY++ = nv15_20_get_sample(tsrcY, x) << shift[0];
         src[0] += srcStride[0];
         dstY += dstStride[0] / sizeof(uint16_t);
     }
@@ -306,12 +322,10 @@ static int nv15_20ToPlanarWrapper(SwsInternal *c, const uint8_t *const src8[],
     for (y = srcSliceH / vsub; y > 0; y--) {
         const uint8_t *tsrcUV = src[1];
         uint16_t *tdstU = dstU, *tdstV = dstV;
-        for (x = c->chrSrcW / 2; x > 0; x--) {
-            *tdstU++ = (((tsrcUV[1] & 0x3 ) << 8) | (tsrcUV[0]        & 0xFF)) << shift[1];
-            *tdstV++ = (((tsrcUV[2] & 0xF ) << 6) | ((tsrcUV[1] >> 2) & 0x3F)) << shift[2];
-            *tdstU++ = (((tsrcUV[3] & 0x3F) << 4) | ((tsrcUV[2] >> 4) & 0xF )) << shift[1];
-            *tdstV++ = (((tsrcUV[4] & 0xFF) << 2) | ((tsrcUV[3] >> 6) & 0x3 )) << shift[2];
-            tsrcUV += 5;
+        /* Chroma is one interleaved stream: sample 2x is U, 2x+1 is V. */
+        for (x = 0; x < c->chrSrcW; x++) {
+            *tdstU++ = nv15_20_get_sample(tsrcUV, 2 * x)     << shift[1];
+            *tdstV++ = nv15_20_get_sample(tsrcUV, 2 * x + 1) << shift[2];
         }
         src[1] += srcStride[1];
         dstU += dstStride[1] / sizeof(uint16_t);
-- 
2.43.0
