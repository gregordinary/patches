 drivers/accel/rocket/rocket_gem.c | 210 ++++++++++++++++++++++++++++++
 drivers/accel/rocket/rocket_gem.h |   4 +
 include/uapi/drm/rocket_accel.h   |  98 ++++++++++++++
 4 files changed, 320 insertions(+), 1 deletion(-)

