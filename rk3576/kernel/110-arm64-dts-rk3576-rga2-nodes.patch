From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gregordinary <33880035+gregordinary@users.noreply.github.com>
Date: Sat, 25 Jul 2026 02:46:23 -0400
Subject: [PATCH] arm64: dts: rockchip: rk3576: add the RGA2 raster accelerator
 nodes

The RK3576 carries two RGA2 raster graphics accelerator cores at
0x27920000 and 0x27930000, each behind its own IOMMU. Neither is
described upstream, so the hardware is dark even though the SoC's VPU
power domain already claims all four of their clocks.

Add the four nodes on the vendor "rockchip,rga2" binding, which the
multicore RGA driver matches. That driver is topology-neutral -- it
derives each core's scheduler index from probe order, not from the
compatible string -- so two identically-compatible nodes come up as
RGA2 core0 and core1 with no driver change.

Both cores sit in RK3576_PD_VPU and take the mainline
rockchip,rk3568-iommu binding for their MMUs; the vendor iommu-v2
compatible the factory device tree uses describes the same block.

Signed-off-by: gregordinary <33880035+gregordinary@users.noreply.github.com>
---
 arch/arm64/boot/dts/rockchip/rk3576.dtsi | 46 ++++++++++++++++++++++++
 1 file changed, 46 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3576.dtsi b/arch/arm64/boot/dts/rockchip/rk3576.dtsi
index 28175d8..374a9f4 100644
--- a/arch/arm64/boot/dts/rockchip/rk3576.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3576.dtsi
@@ -1279,6 +1279,52 @@
 			status = "disabled";
 		};
 
+		rga2_core0: rga@27920000 {
+			compatible = "rockchip,rga2";
+			reg = <0x0 0x27920000 0x0 0x1000>;
+			interrupts = <GIC_SPI 328 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "rga2_core0_irq";
+			clocks = <&cru ACLK_RGA2E_0>, <&cru HCLK_RGA2E_0>,
+				 <&cru CLK_CORE_RGA2E_0>;
+			clock-names = "aclk_rga2_0", "hclk_rga2_0", "clk_rga2_0";
+			power-domains = <&power RK3576_PD_VPU>;
+			iommus = <&rga2_0_mmu>;
+		};
+
+		rga2_0_mmu: iommu@27920f00 {
+			compatible = "rockchip,rk3576-iommu", "rockchip,rk3568-iommu";
+			reg = <0x0 0x27920f00 0x0 0x100>;
+			interrupts = <GIC_SPI 328 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "rga2_0_mmu";
+			clocks = <&cru ACLK_RGA2E_0>, <&cru HCLK_RGA2E_0>;
+			clock-names = "aclk", "iface";
+			power-domains = <&power RK3576_PD_VPU>;
+			#iommu-cells = <0>;
+		};
+
+		rga2_core1: rga@27930000 {
+			compatible = "rockchip,rga2";
+			reg = <0x0 0x27930000 0x0 0x1000>;
+			interrupts = <GIC_SPI 329 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "rga2_core1_irq";
+			clocks = <&cru ACLK_RGA2E_1>, <&cru HCLK_RGA2E_1>,
+				 <&cru CLK_CORE_RGA2E_1>;
+			clock-names = "aclk_rga2_1", "hclk_rga2_1", "clk_rga2_1";
+			power-domains = <&power RK3576_PD_VPU>;
+			iommus = <&rga2_1_mmu>;
+		};
+
+		rga2_1_mmu: iommu@27930f00 {
+			compatible = "rockchip,rk3576-iommu", "rockchip,rk3568-iommu";
+			reg = <0x0 0x27930f00 0x0 0x100>;
+			interrupts = <GIC_SPI 329 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "rga2_1_mmu";
+			clocks = <&cru ACLK_RGA2E_1>, <&cru HCLK_RGA2E_1>;
+			clock-names = "aclk", "iface";
+			power-domains = <&power RK3576_PD_VPU>;
+			#iommu-cells = <0>;
+		};
+
 		vdec: video-codec@27b00000 {
 			compatible = "rockchip,rk3576-vdec";
 			reg = <0x0 0x27b00100 0x0 0x500>,
-- 
2.43.0

